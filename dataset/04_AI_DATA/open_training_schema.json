{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mega HSSE Open Training Record",
  "type": "object",
  "required": [
    "scenario_id",
    "scenario",
    "inputs",
    "expected_decision",
    "evidence_sources",
    "hsse_areas",
    "uncertainty_required"
  ],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "expected_decision": {"type": "string", "minLength": 1},
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "hsse_areas": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1, "maximum": 60}
    },
    "uncertainty_required": {"type": "boolean"},
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test", "benchmark"],
      "default": "train"
    },
    "suite": {
      "type": "string",
      "enum": [
        "general",
        "unsafe_detection",
        "no_guessing",
        "technical_selection",
        "multi_risk",
        "expert_comparison"
      ],
      "default": "general"
    },
    "multi_domain_link": {"type": "boolean", "default": false},
    "expert_decision": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
